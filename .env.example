# Nebius Token Factory (OpenAI-compatible) — NVIDIA Nemotron inference
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LS_MODEL_DEEP=nvidia/Nemotron-3-Ultra-550b-a55b
LS_MODEL_FAST=nvidia/nemotron-3-super-120b-a12b

# Tavily — public knowledge briefings
TAVILY_API_KEY=

# Sandbox (hidden worlds) — empty URL runs the sandbox in-process
LS_SANDBOX_URL=
LS_SANDBOX_TOKEN=change-me
LS_GATE_URL=http://127.0.0.1:8790

LS_DATA_DIR=./data
LS_MAX_LIVE_RUNS=3
LS_MAX_RUNS_PER_DAY=40
LS_LIVE_RUNS=on
